{
  "manifest_version": 3,
  "name": "FocusRead — Reading Assistant",
  "version": "1.0.0",
  "description": "Customise web pages to make reading feel more manageable.",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_title": "FocusRead",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}